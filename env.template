# Albatross configuration. Every key is optional. The easiest way to add them is the Setup page (Ops > Setup) once
# Albatross is running. If you'd rather use a file, copy this to `.env` and fill in what you have: a key set here wins
# over one saved on the Setup page. A job whose key is missing skips its source and the rest keeps running.
# `.env` is gitignored. Never commit it.

# ── Database and ports (docker-compose.yml uses these) ─────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
# The ports on this machine, if 5432 or 8787 is already taken (default 5432 and 8787)
POSTGRES_PORT=
DASHBOARD_PORT=

# ── AI agents ──────────────────────────────────────────────────────────────────────────────────────────────────
# Every LLM agent (analysts, Strategist, News Scout, reports, the CEO memo, memecoin takes, web research) calls
# OpenRouter. Each agent has its own daily dollar cap in code; see docs/MODELS.md.
OPENROUTER_API_KEY=
# Raise an alert when today's OpenRouter spend passes this many dollars.
ALERT_DAILY_SPEND_USD=
# The link in alert messages. Set it to your server's address (e.g. https://albatross.example.com/#/health) if you
# read alerts away from the machine running Albatross.
ALERT_DASHBOARD_URL=
# Swap an agent's model without a code change: "agent=model,agent=model", e.g. "news_scout=deepseek/deepseek-v4.1-flash".
LLM_MODEL_OVERRIDES=
# TypeSafe AI's Jev decision model (jev_scout, jev_analyst). Leave blank to skip those agents.
TYPESAFE_API_KEY=
# Which lane runs the agents: openrouter (default), chatgpt or claude. A plan falls back to OpenRouter when it's out
# of allowance and OPENROUTER_API_KEY is set. The plans need the subscriptions container (see below).
AGENTS_ON=

# ── Market data ────────────────────────────────────────────────────────────────────────────────────────────────
# Hyperliquid, OKX, Coinbase, DexScreener, GeckoTerminal, DefiLlama, Coin Metrics community, alternative.me,
# Polymarket, RugCheck and honeypot.is need no key.
# free Demo key: the universe rebuild takes ~2 min instead of ~14
COINGECKO_API_KEY=
# demo | pro
COINGECKO_PLAN=
# Binance/Bybit/OKX funding and open interest (free)
COINALYZE_API_KEY=
# US macro series (free)
FRED_API_KEY=
# spot ETF flows
SOSOVALUE_API_KEY=
# news
CRYPTOPANIC_API_KEY=
CRYPTOPANIC_PLAN=

# ── Memecoins (the Deep End) ───────────────────────────────────────────────────────────────────────────────────
# candles, token security and holders (paid plan)
BIRDEYE_API_KEY=
# prices; without it the public lite endpoint is used
JUPITER_API_KEY=
# wallet funding and holder lookups
SOLANA_RPC=
CHAINSTACK_URL=
# public repo metadata for dev-led tokens (raises the 60 requests/hour limit)
GITHUB_TOKEN=
# FOMO trader feed via fomoapi.io, an unofficial relay: read NOTICE.md first
FOMOAPI_KEY=

# ── Call feed (optional) ───────────────────────────────────────────────────────────────────────────────────────
# Bearer token a Telegram listener or trading bot presents to POST /api/ingest/calls (deploy/call-feed/README.md).
CALL_FEED_TOKEN=

# ── Alerts (Telegram) ──────────────────────────────────────────────────────────────────────────────────────────
# Your own bot from @BotFather. A chat joins by sending the bot the password whose hash is set here.
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_PASSWORD_HASH=
# optional extra recipient
TELEGRAM_ALERT_CHAT_ID=
# Bot usernames another program long-polls, comma-separated: the alerts bot refuses those tokens.
TELEGRAM_SHARED_BOTS=
# Log calls from the groups you're in with your own Telegram account: an API id and hash from my.telegram.org/apps.
# Sign in and pick the chats on the Setup page.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Website login (server installs behind deploy/compose.server.yml) ───────────────────────────────────────────
# Make the hash with:
#   uv run python -c "import getpass; from albatross.alerts.bot import hash_password; print(hash_password(getpass.getpass()))"
SITE_USER=
SITE_PASSWORD_HASH=
# any long random string; changing it signs every device out
SITE_SESSION_SECRET=
# With no site password, the Setup page answers only on these host names (default localhost,127.0.0.1,::1). Add a
# LAN name to use Setup from another device on your network.
ALLOWED_HOSTS=

# ── Your ChatGPT and Claude plans (optional) ────────────────────────────────────────────────────────────────────
# Start the plans container with `docker compose --profile subscriptions up -d`, then sign in from the Setup page.
# The logins stay inside that container. Your plan's own terms and limits apply.
# Run OpenAI models on your ChatGPT plan through the Codex CLI. Off unless set to true.
CODEX_ENABLED=
# share of the weekly allowance left for your own use (default 5)
CODEX_RESERVE_PCT=
CODEX_BURST_PCT=
# Run agents on your Claude plan through Claude Code. Off unless set to true.
CLAUDE_ENABLED=
# haiku | sonnet (default) | opus
CLAUDE_MODEL=

# ── X (optional) ───────────────────────────────────────────────────────────────────────────────────────────────
# X search through the xAI API, paid per call, for Social Pulse and the memecoin X Scout.
XAI_API_KEY=
# The most the X agents may spend on the xAI API in a day (default 3)
XAI_DAILY_USD=
# auto (default: the API when XAI_API_KEY is set, else the Grok CLI) | api | cli
X_SEARCH_VIA=
# Or X search through the Grok CLI on your own SuperGrok plan (host worker: `uv run python -m albatross host`).
# Social Pulse's weekly share of the pool, in the pool's dollar equivalent
SOCIAL_WEEKLY_USD=
# the whole weekly pool
GROK_POOL_WEEKLY_USD=
# the memecoin X Scout's share
DEEP_X_WEEKLY_USD=
